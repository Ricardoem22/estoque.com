# Copie este arquivo para ".env" e ajuste. Nunca compartilhe o .env.

# Nome do assistente
ASSISTENTE_NOME=Jarvis
# Idioma da saudação: pt ou en
IDIOMA=pt

# Qual IA usar: auto (tenta a local e, sem ela, usa a API), local ou api
MODO=auto

# IA local (Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=qwen2.5:7b

# IA externa (Anthropic) — só necessário se usar MODO=api ou auto sem Ollama
ANTHROPIC_API_KEY=
ANTHROPIC_MODELO=claude-opus-5-5

# Voz (vozes do Windows; "Daniel" é a voz masculina em português)
VOZ_ATIVA=sim
VOZ=Daniel
FALAR_RESPOSTAS=sim
