# Copie este arquivo para ".env" e ajuste. Nunca compartilhe o .env.

# Nome do assistente
ASSISTENTE_NOME=Jarvis
# Idioma da saudação: pt ou en
IDIOMA=pt

# Qual IA usar: auto (tenta a local e, sem ela, usa a API), local ou api
MODO=auto

# IA local (Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=qwen2.5:7b

# IA externa (Anthropic) — só necessário se usar MODO=api ou auto sem Ollama
ANTHROPIC_API_KEY=
ANTHROPIC_MODELO=claude-opus-5-5

# Voz (vozes do Windows; "Daniel" é a voz masculina em português)
VOZ_ATIVA=sim
VOZ=Daniel
FALAR_RESPOSTAS=sim

# Ações no computador: nada é proibido. As que alteram ou apagam algo
# (escrever, mover, copiar, apagar, rodar comando) pedem "s/n" antes.
# Coloque "nao" para executar sem perguntar (por sua conta e risco).
CONFIRMAR_ACOES=sim

# Microfone (aperte Enter sem digitar para falar). Funciona sem internet.
# Modelos: tiny, base, small (padrão), medium — maiores entendem melhor, mas são mais lentos.
OUVIR_MODELO=small
# Idioma da fala: pt, en ou auto (detecta sozinho)
OUVIR_IDIOMA=pt
# Qual microfone usar: vazio = o padrão do Windows; ou o número mostrado por /microfone
OUVIR_DISPOSITIVO=

# Mostra quanto tempo cada resposta levou (sim/nao)
MOSTRAR_TEMPO=sim
